#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// fechamento.tlpp -- montar um resumo de fechamento, em secoes.
//
// Um caso comum: uma funcao longa que monta varias coisas, uma secao de cada
// vez. Cada secao precisa de um array temporario, de um contador, de um texto
// -- e nenhuma delas precisa do que a anterior usou.
//
// ============================================================================
// O QUE MUDA
// ============================================================================
//
// Em AdvPL todo 'Local' vale da declaracao ate o fim da funcao. Uma funcao de
// seis secoes acaba com um bloco de vinte declaracoes no topo, cada uma viva
// do inicio ao fim, e a pergunta "quem mexe nisto?" so tem uma resposta: o
// arquivo inteiro.
//
// Em xtpl um 'local' dentro de um bloco vive so no bloco. Fora dele o nome
// nao existe -- o transpilador recusa. E como nao existe, o ARMAZENAMENTO
// pode ser reaproveitado pela proxima secao.
//
// Os dois sao um recurso so, nao dois. Se cada 'local' dentro de um 'if'
// custasse um slot permanente, uma funcao longa acabaria com quarenta
// declaracoes e as pessoas aprenderiam a icar tudo a mao -- abandonando
// justamente a disciplina que o recurso existe para impor.
//
// ============================================================================
// QUANDO UM SLOT NAO PODE SER DIVIDIDO
// ============================================================================
//
// Passar uma variavel para uma funcao NAO impede o compartilhamento, faca a
// funcao o que fizer:
//
//    aadd(aGuardados, aSecao)     <-- aSecao continua dividindo slot
//
// O AdvPL entrega o OBJETO. Quem recebeu ficou com ele; reatribuir o nome
// depois nao alcanca o que foi entregue.
//
// Um code block e outra coisa -- ele captura a VARIAVEL:
//
//    aadd(aAcoes, {|| processa(aSecao)})   <-- aSecao ganha slot proprio
//
// O bloco roda depois, e quando rodar vai ler o nome. Se o nome tiver sido
// reaproveitado pela secao seguinte, ele le a secao seguinte. Por isso uma
// variavel capturada recebe armazenamento so dela.
//
// Vale para numeros e strings igual a arrays. Nao e sobre tipos.
//
// ============================================================================
// O QUE APARECE NA SAIDA
// ============================================================================
//
//    Local s_1_0  // aVendas, aCustos, cLinha
//
// Um slot, e o comentario diz quem passou por ele. No corpo cada linha o
// escreve com o nome de quem o ocupa ali -- '!aVendas^1^0!' e '!aCustos^1^0!'
// sao o mesmo armazenamento, e da para ler qual e qual.
//
// A variavel capturada aparece separada, com o proprio nome: 'b_3_nMeta'.
//
// ============================================================================
// O CODIGO GERADO NAO E MENOR
// ============================================================================
//
// Onze declaracoes contra nove da versao a mao -- as cadeias fundidas trazem
// os temporarios delas ('fi', 'fo', 'fv'), e sao dois pares porque sao duas
// cadeias.
//
// O ganho deste recurso nao esta na saida. Esta no que o transpilador
// RECUSA: ler 'aVendas' na secao 3 compila e roda na versao a mao, e da o
// numero errado. Em xtpl o nome nao existe fora do bloco, e a linha e
// recusada dizendo onde ele foi visto pela ultima vez.
//
// Um recurso cujo ganho e um erro que nao acontece nao aparece na contagem de
// linhas. E mesmo assim e o que se quer.
//
// Compare com fechamento_mao.tlpp.
// ============================================================================


user function fechamento(cFilial, aAcoes)

  Local nTotal := 0
  Local cResumo := ""

  Local s_1_0      // aVendas, aCustos, aLinha
  Local b_3_nMeta
  Local fi_1_0
  Local fi_2_0
  Local fo_1_0
  Local fo_2_0
  Local fv_1_0
  Local fv_2_0
  Local s_1_nSoma

  // ---- secao 1: vendas ---------------------------------------------------
  if !empty(cFilial)
    let aVendas as s_1_0
    let nSoma as s_1_nSoma
    !aVendas^1^0! := buscaVendas(cFilial)
    fo_1_0 := 0
    For fi_1_0 := 1 To Len(!aVendas^1^0!)
      fv_1_0 := !aVendas^1^0![fi_1_0]
      fv_1_0 := fv_1_0:nValor
      fo_1_0 := fo_1_0 + fv_1_0
    Next
    s_1_nSoma := fo_1_0

    nTotal := nTotal + s_1_nSoma
    cResumo := cResumo + "vendas: " + cValToChar(s_1_nSoma) + CRLF
  endif

  // ---- secao 2: custos. Mesmo slot da secao 1 ----------------------------
  if !empty(cFilial)
    let aCustos as s_1_0
    let nSoma as s_1_nSoma
    !aCustos^1^0! := buscaCustos(cFilial)
    fo_2_0 := 0
    For fi_2_0 := 1 To Len(!aCustos^1^0!)
      fv_2_0 := !aCustos^1^0![fi_2_0]
      fv_2_0 := fv_2_0:nValor
      fo_2_0 := fo_2_0 + fv_2_0
    Next
    s_1_nSoma := fo_2_0

    nTotal := nTotal - s_1_nSoma
    cResumo := cResumo + "custos: " + cValToChar(s_1_nSoma) + CRLF
  endif

  // ---- secao 3: entregue a uma funcao, e ainda divide o slot -------------
  if nTotal > 0
    let aLinha as s_1_0
    !aLinha^1^0! := {cFilial, nTotal}

    // aadd entrega o array. Quem recebeu ficou com ele, e reaproveitar o
    // nome depois nao alcanca o que foi entregue.
    aadd(aAcoes, !aLinha^1^0!)
  endif

  // ---- secao 4: capturada por um bloco, e ai NAO divide -------------------
  if nTotal > 0
    let nMeta as b_3_nMeta
    b_3_nMeta := calculaMeta(cFilial)

    // O bloco le nMeta quando rodar, la na frente. Por isso nMeta ganha
    // armazenamento proprio: se dividisse, leria o que a proxima secao
    // tivesse posto ali.
    aadd(aAcoes, {|| avisaMeta(cFilial, b_3_nMeta)})
  endif

  conout("fechamento " + cValToChar(cFilial) + ": " + cValToChar(nTotal))

  return cResumo

// --------------------------------------------------------------------------------
// the end