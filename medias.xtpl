// medias.xtpl -- limpar um arquivo e tirar a media de cada linha, numa passada.
//
// Cada linha deve ter tres campos numericos separados por virgula. As que
// tem, viram a media dos tres; as que nao tem sao descartadas e contadas.
//
//    12, 14, 16   ->  14
//    8,9,10       ->  9
//    1, x, 3      ->  descartada
//
// O 'tap' conta as linhas enquanto elas passam. Contar antes com um
// 'lines(cArquivo) |> count' separado leria o arquivo duas vezes.
//
// Nao ha funcao auxiliar nenhuma aqui, alem de ehNumero, que existe so porque
// o padrao merece um nome. Uma CADEIA nao pode ficar dentro de um lambda --
// icar as etapas para fora do bloco as faria rodar antes dele --, mas todo
// verbo de cadeia tambem e uma funcao comum: 'allof(a, ehNumero)' e
// 'asum(map(a, val))' fazem o mesmo dentro do lambda, sem cadeia.
//
// A validacao usa a classe Regex do TLPP. 'matches' e estatico e exige a
// string INTEIRA -- verificado rodando, porque o exemplo do TDN diz que
// matches('^(abc)*$', 'abc123') e .T. e na verdade e .F.
// --------------------------------------------------------------------------------

using namespace tlpp.regex

user function medias(cArquivo)
  local nLidas := 0
  local aMedias := lines(cArquivo)                                      ;
                   |> tap([l] nLidas += 1)                              ;
                   |> map([l] split(alltrim(l), ","))                   ;
                   |> filter([a] len(a) == 3 .and. allof(a, ehNumero))  ;
                   |> map([a] asum(map(a, val)) / 3)

  xconout("linhas: ", nLidas, "  boas: ", len(aMedias), ;
          "  descartadas: ", nLidas - len(aMedias))

  return aMedias

static function ehNumero(cTexto)
  return Regex():matches("^\s*-?[0-9]+(\.[0-9]+)?\s*$", cTexto)

// --------------------------------------------------------------------------------
// the end
