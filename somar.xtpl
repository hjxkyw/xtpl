// somar.xtpl -- somar campo a campo as linhas correspondentes de dois arquivos.
//
// Cada arquivo tem linhas de campos numericos separados por virgula. A linha
// N de um e somada com a linha N do outro, campo a campo:
//
//    A:  10, 20, 30          ->   11, 22, 33
//    B:   1,  2,  3
//
// 'zip' para no mais curto, sem avisar -- e como o Raku faz. Entao aqui tanto
// as linhas sobrando quanto os campos sobrando sao contados e ditos, porque
// perder metade de um arquivo em silencio nao e resultado, e um bug.
//
// Rode:  appserver.exe -env=SeuAmbiente -run=u_somar
// --------------------------------------------------------------------------------

using namespace tlpp.regex

user function somar(cArqA, cArqB)
  local nLinhasA := 0
  local nLinhasB := 0
  local aA := lines(cArqA) |> tap([l] nLinhasA += 1) |> map([l] split(alltrim(l), ","))
  local aB := lines(cArqB) |> tap([l] nLinhasB += 1) |> map([l] split(alltrim(l), ","))
  local aSomas := {}
  local nDesiguais := 0
  local nSujas := 0
  local nX := 0

  // Campo a campo, linha a linha. O zip de dentro para no mais curto das duas
  // linhas; o de fora, no mais curto dos dois arquivos.
  aSomas := zip(aA, aB, [x, y] zip(x, y, [p, q] val(p) + val(q)))

  // O que o zip descartou em silencio, dito em voz alta.
  nDesiguais := zip(aA, aB, [x, y] len(x) == len(y)) |> count([l] !l)
  nSujas := zip(aA, aB, [x, y] tudoNumero(x) .and. tudoNumero(y)) |> count([l] !l)

  xconout("A: ", nLinhasA, " linhas   B: ", nLinhasB, " linhas")
  xconout("somadas: ", len(aSomas), ;
          "   linhas perdidas: ", max(nLinhasA, nLinhasB) - len(aSomas))
  xconout("com numero de campos diferente: ", nDesiguais, ;
          "   com campo nao numerico: ", nSujas)

  for nX := 1 to len(aSomas)
    conout(cValToChar(nX) + ": " + mostrar(aSomas[nX]))
  next

  return aSomas

// ---- auxiliares ----------------------------------------------------------

static function tudoNumero(aCampos)
  return allof(aCampos, ehNumero)

static function ehNumero(cTexto)
  return Regex():matches("^\s*-?[0-9]+(\.[0-9]+)?\s*$", cTexto)

// join() com um separador, para a linha sair legivel.
static function mostrar(aValores)
  return aValores |> map([n] alltrim(str(n))) |> join(", ")

// --------------------------------------------------------------------------------
// the end
