#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 15_control.tlpp -- constructs that lower to plain AdvPL, no runtime needed
// --------------------------------------------------------------------------------

user function testControl(oUser, nLimit, aItens)

  Local nTotal := 0
  Local cCity
  Local lDone

  Local s_1_0  // lReady, cNode, i, __each, __times, nSubject
  Local s_1_1  // oItem, __ntimes
  Local s_1_2  // __eachi, nIndice

  // conditional binding: the value is bound, then tested
  let lReady as s_1_0
  !lReady^1^0! := checkReady()

  If !lReady^1^0!
    conout("ready")
  endif

  let cNode as s_1_0

  While (!cNode^1^0! := nextNode()) != Nil
    conout("node: " + !cNode^1^0!)
  enddo

  let i as s_1_0

  for !i^1^0! := 1 to 3
    nTotal := nTotal + !i^1^0!
  next

  // 'for' binds the element; the index is optional and only generated
  // when you name it. Both are ordinary block locals of the loop.
  let each as s_1_0
  let oItem as s_1_1
  let eachi as s_1_2
  !each^1^0! := aItens

  For !eachi^1^2! := 1 To Len(!each^1^0!)
    !oItem^1^1! := !each^1^0![!eachi^1^2!]
    nTotal := nTotal + !oItem^1^1!:nValor
  next

  let each as s_1_0
  let oItem as s_1_1
  let nIndice as s_1_2
  !each^1^0! := aItens

  For !nIndice^1^2! := 1 To Len(!each^1^0!)
    !oItem^1^1! := !each^1^0![!nIndice^1^2!]
    conout(cValToChar(!nIndice^1^2!) + ": " + !oItem^1^1!:cCodigo)
  next

  // 'for <n> times' repeats without inventing a counter you never read
  let times as s_1_0

  For !times^1^0! := 1 To 3
    conout("linha")
  next

  let times as s_1_0
  let ntimes as s_1_1
  !ntimes^1^1! := len(aItens)

  For !times^1^0! := 1 To !ntimes^1^1!
    nTotal := nTotal + 1
  next

  // 'do case with' names the subject and evaluates it once. The conditions
  // are ordinary AdvPL, and the variable is an ordinary block local.
  let nSubject as s_1_0
  !nSubject^1^0! := calcTotal(nTotal)

  Do Case
    case !nSubject^1^0! == 6
      conout("exactly six")
    case !nSubject^1^0! > 3
      conout("more than three: " + cValToChar(!nSubject^1^0!))
    case isReady(!nSubject^1^0!)
      conout("ready")
    otherwise
      conout("small")
  endcase

  // plain 'do case' is untouched
  do case
    case nTotal == 0
      conout("zero")
  endcase

  // optional chaining: a missing link yields Nil rather than crashing
  cCity := If(oUser != Nil .And. oUser:oAddress != Nil, oUser:oAddress:cCity, Nil)

  // postfix modifiers
  If nTotal > 5
    lDone := .T.
  EndIf

  If nTotal == 0
    resetAll()
  EndIf

  While nTotal < 0
    conout("counting")
  EndDo

  If nTotal > 100
    logExit("finished")
    closeCursor()
    Return nTotal
  EndIf

  logExit("finished")
  closeCursor()
  return nTotal

// --------------------------------------------------------------------------------
// the end