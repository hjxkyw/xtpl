#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 20_object.tlpp -- 'with object', for code that repeats the same subject
//
// The subject is evaluated once and bound to a hidden block local. Inside the
// block, a ':' in a position where AdvPL could not have put one means "the
// subject". Member access on anything else, '::' for self and ':=' for
// assignment are all left alone.
// --------------------------------------------------------------------------------

user function testObject(oModel, oOutro, aRows)

  Local cNome := ""
  Local nTam := 0

  Local s_1_obj
  Local s_2_obj

  let obj as s_1_obj
  s_1_obj := oModel:GetModel("SA1DETAIL")
    s_1_obj:SetValue("A1_COD", "000001")
    s_1_obj:SetValue("A1_NOME", "ACME")
    cNome := s_1_obj:GetValue("A1_NOME")
    nTam := len(s_1_obj:GetValue("A1_COD"))

    // untouched: another object, an index, an assignment, self
    cNome := oOutro:cRazao
    nTam := aRows[1]
    nTam := 5
    cNome := ::cUltimo

    // nesting: the innermost subject wins, then the outer resumes
    let obj as s_2_obj
    s_2_obj := oOutro
      s_2_obj:Ativa()
      cNome := s_2_obj:cRazao

    s_1_obj:Grava()

  conout(cValToChar(nTam))

  return cNome

// --------------------------------------------------------------------------------
// the end