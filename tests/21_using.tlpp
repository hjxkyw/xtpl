#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 21_using.tlpp -- scoped work areas.
//
// Forgetting to restore an alias is a classic Protheus bug, and its damage
// appears somewhere else entirely. The area, the index order and the record
// pointer are put back at every way out of the block, early returns included
// -- which is the defer machinery, so the two have to agree on order:
// deferred statements first, since they may still want the area, then the
// work areas, innermost block first.
// --------------------------------------------------------------------------------

user function testUsing(cAlias, nX)

  Local nT := 0
  Local aC := {}

  Local far_0_0
  Local fo_0_0
  Local frc_0_0
  Local fv_0_0
  Local s_1_usearea
  Local s_1_useord
  Local s_1_userec
  Local s_2_usealias
  Local s_2_usearea
  Local s_2_userec

  let usearea as s_1_usearea
  let userec as s_1_userec
  s_1_usearea := Alias()
  DbSelectArea("SA1")
  s_1_userec := SA1->(RecNo())
  let useord as s_1_useord
  s_1_useord := SA1->(IndexOrd())
  SA1->(DbSetOrder(1))
    nT := SA1->A1_SALDO
    If nX > 100  // restored before the return
      SA1->(DbSetOrder(s_1_useord))
      SA1->(DbGoto(s_1_userec))
      If !Empty(s_1_usearea)
        DbSelectArea(s_1_usearea)
      EndIf
      Return nT
    EndIf

    nT := nT + 1

    let usearea as s_2_usearea
    let userec as s_2_userec
    let usealias as s_2_usealias
    s_2_usealias := cAlias
    s_2_usearea := Alias()
    DbSelectArea(s_2_usealias)  // a variable holds the alias here
    s_2_userec := (s_2_usealias)->(RecNo())
      nT := nT + 1
    (s_2_usealias)->(DbGoto(s_2_userec))
    If !Empty(s_2_usearea)
      DbSelectArea(s_2_usearea)
    EndIf
  SA1->(DbSetOrder(s_1_useord))
  SA1->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

  // a chain walks its own area and restores it the same way
  far_0_0 := Alias()
  DbSelectArea("SA1")
  frc_0_0 := SA1->(RecNo())
  SA1->(DbGoTop())
  fo_0_0 := {}

  While !SA1->(Eof())
    If SA1->A1_SALDO > 0
      fv_0_0 := SA1->A1_COD
      AAdd(fo_0_0, fv_0_0)
    EndIf
    SA1->(DbSkip())
  EndDo

  SA1->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  aC := fo_0_0

  return nT + len(aC)

// --------------------------------------------------------------------------------
// the end