#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 26_raw.tlpp -- handing lines to the AdvPL preprocessor untouched
//
// A #command or #xtranslate rewrites syntax, not identifiers, so a line like
// '@ 10, 5 SAY ... GET ...' is not AdvPL yet -- it becomes AdvPL only after
// the preprocessor runs, which is after xtpl. 'raw' says: do not try to
// understand this line.
//
// Declared variables are still renamed inside raw, so block locals work.
// Every other word is left alone instead of being reported as undeclared.
// --------------------------------------------------------------------------------

#xtranslate MOSTRE <x> QUANDO <c> => If <c> ; conout(<x>) ; EndIf
#xtranslate ANOTE <x> => conout("nota: " + <x>)

user function testRaw(oDlg)

  Local cNome := ""
  Local nTotal := 0
  Local cSql := ""

  Local b_1_cAux

  // one line
  MOSTRE cValToChar(nTotal) QUANDO nTotal > 0

  // a block, for a screen or a dialog
    ANOTE "primeira"
    ANOTE "segunda"

  // a block local used inside raw: renamed like anywhere else, and pinned,
  // because GET passes it by reference and the dialog outlives the block
  if nTotal > 0
    let cAux as b_1_cAux
    b_1_cAux := ""
    ANOTE b_1_cAux
  endif

  // normal xtpl carries on around it
  nTotal := nTotal + 1
  cSql := "SELECT * FROM SA1"

  conout(cSql)

  return cNome

// --------------------------------------------------------------------------------
// the end