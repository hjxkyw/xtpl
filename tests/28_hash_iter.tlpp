#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 28_hash_iter.tlpp -- keys, values and pairs.
//
// 'for' walks arrays, so a hash could not be iterated at all -- it was
// invisible to the whole pipeline. These return arrays, so nothing else
// needed changing: 'for', the chain, the verbs and interpolation all compose
// with them as they stand.
//
// They go through THashMap:List(), which fills an array with one row per
// entry, key in column 1 and value in column 2.
// --------------------------------------------------------------------------------

user function testHashIter(hCfg, hSaldos)

  Local aMv := {}
  Local nTotal := 0
  Local cLista := ""
  Local lVazio := .F.
  Local aPares := {}

  Local b_0_k
  Local b_0_p
  Local ht_1_0
  Local pt_0_0
  Local pt_0_1
  Local s_1_cChave
  Local s_1_each
  Local s_1_eachi

  // a hash can be walked now
  let each as s_1_each
  let cChave as s_1_cChave
  let eachi as s_1_eachi
  s_1_each := u_xtpl_keys(hCfg)

  For s_1_eachi := 1 To Len(s_1_each)
    s_1_cChave := s_1_each[s_1_eachi]
    ht_1_0 := Nil
    hCfg:Get(s_1_cChave, @ht_1_0)
    conout((cValToChar(s_1_cChave) + " = " + cValToChar(ht_1_0)))

  next

  pt_0_0 := u_xtpl_asum(u_xtpl_values(hSaldos))
  nTotal := pt_0_0

  pt_0_0 := u_xtpl_filter(u_xtpl_keys(hCfg), {|b_0_k| u_xtpl_starts(b_0_k, "MV_")})
  aMv := pt_0_0

  pt_0_0 := u_xtpl_sort(u_xtpl_keys(hCfg))
  pt_0_1 := u_xtpl_join(pt_0_0, ", ")
  cLista := pt_0_1

  pt_0_0 := u_xtpl_noneof(u_xtpl_keys(hCfg), {|b_0_k| .T.})
  lVazio := pt_0_0

  // pairs keeps them together: {chave, valor} per row
  pt_0_0 := u_xtpl_reject(u_xtpl_pairs(hCfg), {|b_0_p| b_0_p[2] == Nil})
  aPares := pt_0_0

  return nTotal + len(aMv) + len(cLista) + len(aPares) + iif(lVazio, 1, 0)

// --------------------------------------------------------------------------------
// the end