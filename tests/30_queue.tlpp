#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Uma variavel de bloco num slot se escreve '!nome^...!'. Com dois
// numeros o armazenamento e dividido e nao tem nome honesto --
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Com um so, o slot
// leva o nome de quem o ocupa, que e o unico.
//
// '%nome^n%' e a que nao ganhou slot: fixada por uma captura, um '@',
// uma linha 'raw' ou um 'defer', ou o parametro de um lambda.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => __stk_<num1>_<num2>
#translate !<name>^<num>! => __stk_<num>_<name>
#translate %<name>^<num>% => __blk_<num>_<name>

// 30_queue.tlpp -- a ring-buffer queue, and method names that collide.
//
// AdvPL arrays are already dynamic, so a stack is AAdd plus ATail plus aSize
// and a linked list buys nothing. Taking from the FRONT is the gap: ADel then
// aSize moves every remaining element, once per pop. A ring buffer moves
// nothing.
//
// It also pins a bug the queue found: a method whose name matches a runtime
// verb is not that verb. 'oFila:Count()' was being rewritten to
// 'oFila:__xtpl_count()', and so was any object with a Map or First method.
// --------------------------------------------------------------------------------

user function testQueue(aPedidos, oModelo)

  Local oFila
  Local oGrande
  Local nTotal := 0
  Local xItem := Nil
  Local nOutro := 0

  Local __stk_1_each
  Local __stk_1_eachi
  Local __stk_1_oPedido

  oFila := u_xtpl_queue()
  oGrande := u_xtpl_queue(256)

  let each as __stk_1_each
  let oPedido as __stk_1_oPedido
  let eachi as __stk_1_eachi
  !each^1! := aPedidos
  For !eachi^1! := 1 To Len(!each^1!)
    !oPedido^1! := !each^1![!eachi^1!]
    oFila:Push(!oPedido^1!)
  next

  while !oFila:IsEmpty()
    xItem := oFila:Pop()
    nTotal := nTotal + iif(xItem == Nil, 0, 1)
  enddo

  // methods, not verbs
  nOutro := oModelo:Count() + oModelo:First(1) + oFila:Count()

  return nTotal + nOutro + oGrande:Count()

// --------------------------------------------------------------------------------
// the end