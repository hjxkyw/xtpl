#include "totvs.ch"
#include "tlpp-core.th"

// 34_stream_stages.tlpp -- scan, expand, tap and pairwise.
//
// All four are steps: the value carries on down the chain. expand is the
// structurally odd one -- it opens a For inside the fused loop, so the rest
// of the chain runs once per inner element, and that block closes with Next
// rather than EndIf. Tracking what closes a block, instead of counting how
// many are open, is what makes that possible.
// --------------------------------------------------------------------------------

user function testStreamStages(aMovs, aRows, aLeituras)

  Local aSaldos := {}
  Local aCodigos := {}
  Local aDeltas := {}
  Local aProdutos := {}

  Local fa_0_0
  Local far_0_0
  Local fbg_0_0
  Local fhd_0_0
  Local fi_0_0
  Local fj_0_0
  Local fo_0_0
  Local fol_0_0
  Local fpv_0_0
  Local frc_0_0
  Local frd_0_0
  Local fv_0_0

  // the balance after each movement, not just the closing one
  fa_0_0 := 0
  fo_0_0 := {}

  For fi_0_0 := 1 To Len(aMovs)
    fv_0_0 := aMovs[fi_0_0]
    fv_0_0 := fv_0_0:nValor
    fa_0_0 := fa_0_0 + fv_0_0
    fv_0_0 := fa_0_0
    AAdd(fo_0_0, fv_0_0)
  Next

  aSaldos := fo_0_0

  // look into the chain without taking it apart: the value is untouched
  fo_0_0 := {}

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    If fv_0_0:nSaldo > 0
      conout("passou: " + fv_0_0:cCod)
      fv_0_0 := fv_0_0:cCod
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next

  aCodigos := fo_0_0

  // each reading with the one before it: n readings give n-1 deltas
  fpv_0_0 := Nil
  fhd_0_0 := .F.
  fo_0_0 := {}

  For fi_0_0 := 1 To Len(aLeituras)
    fv_0_0 := aLeituras[fi_0_0]
    fv_0_0 := fv_0_0:nMedidor
    fol_0_0 := fpv_0_0
    frd_0_0 := fhd_0_0
    fpv_0_0 := fv_0_0
    fhd_0_0 := .T.
    If frd_0_0
      fv_0_0 := {fol_0_0, fv_0_0}
      fv_0_0 := fv_0_0[2] - fv_0_0[1]
      AAdd(fo_0_0, fv_0_0)
    EndIf
  Next

  aDeltas := fo_0_0

  // one order becomes its items, and the chain carries on with the items
  far_0_0 := Alias()
  DbSelectArea("SC5")
  frc_0_0 := SC5->(RecNo())
  SC5->(DbGoTop())
  fo_0_0 := {}

  While !SC5->(Eof())
    fbg_0_0 := itensDoPedido(SC5->C5_NUM)
    For fj_0_0 := 1 To Len(fbg_0_0)
      fv_0_0 := fbg_0_0[fj_0_0]
      fv_0_0 := fv_0_0:cProduto
      AAdd(fo_0_0, fv_0_0)
    Next
    SC5->(DbSkip())
  EndDo

  SC5->(DbGoto(frc_0_0))

  If !Empty(far_0_0)
    DbSelectArea(far_0_0)
  EndIf

  aProdutos := fo_0_0

  return len(aSaldos) + len(aCodigos) + len(aDeltas) + len(aProdutos)

// --------------------------------------------------------------------------------
// the end