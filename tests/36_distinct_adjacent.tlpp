#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Uma variavel de bloco num slot se escreve '!nome^...!'. Com dois
// numeros o armazenamento e dividido e nao tem nome honesto --
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Com um so, o slot
// leva o nome de quem o ocupa, que e o unico.
//
// '%nome^n%' e a que nao ganhou slot: fixada por uma captura, um '@',
// uma linha 'raw' ou um 'defer', ou o parametro de um lambda.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => __stk_<num1>_<num2>
#translate !<name>^<num>! => __stk_<num>_<name>
#translate %<name>^<num>% => __blk_<num>_<name>

// 36_distinct_adjacent.tlpp -- adjacent dedup, and the largest element.
//
// distinctAdjacent drops ADJACENT duplicates -- 'distinctAdjacent' in the Unix sense, not 'distinct'
// in the SQL one. It compares each element against the previous, so it is one
// pass holding one value, where distinct compares against everything kept so
// far and blocks fusion. Over unsorted input they give different answers.
//
// maxby gives the largest ELEMENT by a key, where amax gives the largest key
// and loses the row it came from. Otherwise you sort everything to look at
// one of them.
// --------------------------------------------------------------------------------

user function testUniqMaxby(aRows)

  Local aPedidos := {}
  Local oMaior := Nil
  Local oMenor := Nil
  Local aNumeros := {}

  Local __blk_0_p
  Local __blk_0_r
  Local __blk_1_r
  Local __fuse_area_1_0
  Local __fuse_best_0_0
  Local __fuse_i_0_0
  Local __fuse_last_0_0
  Local __fuse_last_1_0
  Local __fuse_open_0_0
  Local __fuse_open_1_0
  Local __fuse_out_0_0
  Local __fuse_out_1_0
  Local __fuse_probe_0_0
  Local __fuse_probe_1_0
  Local __fuse_rec_1_0
  Local __fuse_src_0_0
  Local __fuse_v_0_0
  Local __fuse_v_1_0
  Local __stk_1_usearea
  Local __stk_1_useord
  Local __stk_1_userec


  // no key: compares the element itself
  __fuse_src_0_0 := aRows
  __fuse_open_0_0 := .F.
  __fuse_last_0_0 := Nil
  __fuse_probe_0_0 := Nil
  __fuse_out_0_0 := {}
  For __fuse_i_0_0 := 1 To Len(__fuse_src_0_0)
    __fuse_v_0_0 := __fuse_src_0_0[__fuse_i_0_0]
    %r^0% := __fuse_v_0_0
    __fuse_v_0_0 := %r^0%:cPedido
    __fuse_probe_0_0 := __fuse_v_0_0
    If !(__fuse_open_0_0 .And. (__fuse_probe_0_0 == __fuse_last_0_0))
      __fuse_open_0_0 := .T.
      __fuse_last_0_0 := __fuse_probe_0_0
      AAdd(__fuse_out_0_0, __fuse_v_0_0)
    EndIf
  Next
  aPedidos := __fuse_out_0_0

  __fuse_src_0_0 := aRows
  __fuse_best_0_0 := Nil
  __fuse_open_0_0 := .F.
  __fuse_probe_0_0 := Nil
  __fuse_out_0_0 := Nil
  For __fuse_i_0_0 := 1 To Len(__fuse_src_0_0)
    __fuse_v_0_0 := __fuse_src_0_0[__fuse_i_0_0]
    %r^0% := __fuse_v_0_0
    __fuse_v_0_0 := %r^0%:oPed
    %p^0% := __fuse_v_0_0
    __fuse_probe_0_0 := %p^0%:nValor
    If !__fuse_open_0_0 .Or. __fuse_probe_0_0 > __fuse_best_0_0
      __fuse_open_0_0 := .T.
      __fuse_best_0_0 := __fuse_probe_0_0
      __fuse_out_0_0 := __fuse_v_0_0
    EndIf
  Next
  oMaior := __fuse_out_0_0
  __fuse_src_0_0 := aRows
  __fuse_best_0_0 := Nil
  __fuse_open_0_0 := .F.
  __fuse_probe_0_0 := Nil
  __fuse_out_0_0 := Nil
  For __fuse_i_0_0 := 1 To Len(__fuse_src_0_0)
    __fuse_v_0_0 := __fuse_src_0_0[__fuse_i_0_0]
    %r^0% := __fuse_v_0_0
    __fuse_v_0_0 := %r^0%:oPed
    %p^0% := __fuse_v_0_0
    __fuse_probe_0_0 := %p^0%:nValor
    If !__fuse_open_0_0 .Or. __fuse_probe_0_0 < __fuse_best_0_0
      __fuse_open_0_0 := .T.
      __fuse_best_0_0 := __fuse_probe_0_0
      __fuse_out_0_0 := __fuse_v_0_0
    EndIf
  Next
  oMenor := __fuse_out_0_0

  // over an ordered table: the distinct order numbers, in one pass
  let usearea as __stk_1_usearea
  let userec as __stk_1_userec
  !usearea^1! := Alias()
  DbSelectArea("SC6")
  !userec^1! := SC6->(RecNo())
  let useord as __stk_1_useord
  !useord^1! := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    __fuse_area_1_0 := Alias()
    DbSelectArea("SC6")
    __fuse_rec_1_0 := SC6->(RecNo())
    SC6->(DbGoTop())
    __fuse_open_1_0 := .F.
    __fuse_last_1_0 := Nil
    __fuse_probe_1_0 := Nil
    __fuse_out_1_0 := {}
    While !SC6->(Eof())
      __fuse_probe_1_0 := SC6->C6_NUM
      If !(__fuse_open_1_0 .And. (__fuse_probe_1_0 == __fuse_last_1_0))
        __fuse_open_1_0 := .T.
        __fuse_last_1_0 := __fuse_probe_1_0
        __fuse_v_1_0 := SC6->C6_NUM
        AAdd(__fuse_out_1_0, __fuse_v_1_0)
      EndIf
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(__fuse_rec_1_0))
    If !Empty(__fuse_area_1_0)
      DbSelectArea(__fuse_area_1_0)
    EndIf
    aNumeros := __fuse_out_1_0
  SC6->(DbSetOrder(!useord^1!))
  SC6->(DbGoto(!userec^1!))
  If !Empty(!usearea^1!)
    DbSelectArea(!usearea^1!)
  EndIf

  conout(cValToChar(oMaior != Nil) + cValToChar(oMenor != Nil))

  return len(aPedidos) + len(aNumeros)

// --------------------------------------------------------------------------------
// the end