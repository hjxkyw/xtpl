#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 38_first_count.tlpp -- the first match, and how many match.
//
// Both replace 'filter(...) then look at the result', which builds an array
// to answer a question that does not need one -- and in first's case keeps
// searching after the answer is known.
//
// count reads the element, so a chain over rows() needs no map before it.
// first does not: it hands the element back, and a work-area record is not a
// value, so it needs something a map has made.
// --------------------------------------------------------------------------------

user function testFirstCount(aRows, cNum)

  Local oAtrasado := Nil
  Local nGrandes := 0
  Local nItens := 0
  Local nComSaldo := 0

  Local far_1_0
  Local fi_0_0
  Local fo_0_0
  Local fo_1_0
  Local frc_1_0
  Local fv_0_0
  Local s_1_usearea
  Local s_1_useord
  Local s_1_userec

  // stops at the first match instead of collecting every one
  fo_0_0 := Nil

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:oPed
    If fv_0_0:lAtraso
      fo_0_0 := fv_0_0
      Exit
    EndIf
  Next

  oAtrasado := fo_0_0

  fo_0_0 := 0

  For fi_0_0 := 1 To Len(aRows)
    fv_0_0 := aRows[fi_0_0]
    fv_0_0 := fv_0_0:nValor
    If fv_0_0 > 100
      fo_0_0 := fo_0_0 + 1
    EndIf
  Next

  nGrandes := fo_0_0

  let usearea as s_1_usearea
  let userec as s_1_userec
  s_1_usearea := Alias()
  DbSelectArea("SC6")
  s_1_userec := SC6->(RecNo())
  let useord as s_1_useord
  s_1_useord := SC6->(IndexOrd())
  SC6->(DbSetOrder(1))
    // how many items in this order, without building the array of them
    far_1_0 := Alias()
    DbSelectArea("SC6")
    frc_1_0 := SC6->(RecNo())
    SC6->(DbSeek(xFilial("SC6") + cNum))
    fo_1_0 := 0
    While !SC6->(Eof())
      If !(SC6->C6_NUM == cNum)
        Exit
      EndIf
      fo_1_0 := fo_1_0 + 1
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_1_0))
    If !Empty(far_1_0)
      DbSelectArea(far_1_0)
    EndIf
    nItens := fo_1_0

    // a predicate reads the record directly
    far_1_0 := Alias()
    DbSelectArea("SC6")
    frc_1_0 := SC6->(RecNo())
    SC6->(DbGoTop())
    fo_1_0 := 0
    While !SC6->(Eof())
      If SC6->C6_QUANT > 0
        fo_1_0 := fo_1_0 + 1
      EndIf
      SC6->(DbSkip())
    EndDo
    SC6->(DbGoto(frc_1_0))
    If !Empty(far_1_0)
      DbSelectArea(far_1_0)
    EndIf
    nComSaldo := fo_1_0

  SC6->(DbSetOrder(s_1_useord))
  SC6->(DbGoto(s_1_userec))

  If !Empty(s_1_usearea)
    DbSelectArea(s_1_usearea)
  EndIf

  conout(cValToChar(oAtrasado != Nil))

  return nGrandes + nItens + nComSaldo

// --------------------------------------------------------------------------------
// the end