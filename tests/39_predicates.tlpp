#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Uma variavel de bloco num slot se escreve '!nome^...!'. Com dois
// numeros o armazenamento e dividido e nao tem nome honesto --
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Com um so, o slot
// leva o nome de quem o ocupa, que e o unico.
//
// '%nome^n%' e a que nao ganhou slot: fixada por uma captura, um '@',
// uma linha 'raw' ou um 'defer', ou o parametro de um lambda.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => __stk_<num1>_<num2>
#translate !<name>^<num>! => __stk_<num>_<name>
#translate %<name>^<num>% => __blk_<num>_<name>

// 39_predicates.tlpp -- does any / do all / does none of them match.
//
// There was no way to ask this without building a filtered array and testing
// its length, which reads the whole collection to answer a question that is
// usually settled by the first element.
//
// Fused, the loop leaves as soon as it knows -- and over rows() that means
// the walk stops rather than reading the rest of the table.
// --------------------------------------------------------------------------------

user function testPredicates(aRows, aNums)

  Local lAlguem := .F.
  Local lTodos := .F.
  Local lNenhum := .F.
  Local lNegativo := .F.
  Local lOrdenado := .F.

  Local __blk_0_n
  Local __blk_0_r
  Local __fuse_area_0_0
  Local __fuse_i_0_0
  Local __fuse_out_0_0
  Local __fuse_rec_0_0
  Local __fuse_src_0_0
  Local __fuse_v_0_0
  Local __pipe_tmp_0_0
  Local __pipe_tmp_0_1

  // one stage on its own stays a call -- the runtime version stops early too
  __pipe_tmp_0_0 := u_xtpl_anyof(aRows, {|%r^0%| !%r^0%:lPago})
  lAlguem := __pipe_tmp_0_0

  // fused: map then the predicate, leaving at the first answer
  __fuse_src_0_0 := aRows
  __fuse_out_0_0 := .T.

  For __fuse_i_0_0 := 1 To Len(__fuse_src_0_0)
    __fuse_v_0_0 := __fuse_src_0_0[__fuse_i_0_0]
    __fuse_v_0_0 := __fuse_v_0_0:nValor
    If !(__fuse_v_0_0 > 0)
      __fuse_out_0_0 := .F.
      Exit
    EndIf
  Next

  lTodos := __fuse_out_0_0
  __fuse_src_0_0 := aRows
  __fuse_out_0_0 := .T.

  For __fuse_i_0_0 := 1 To Len(__fuse_src_0_0)
    __fuse_v_0_0 := __fuse_src_0_0[__fuse_i_0_0]
    __fuse_v_0_0 := __fuse_v_0_0:cCod
    If empty(__fuse_v_0_0)
      __fuse_out_0_0 := .F.
      Exit
    EndIf
  Next

  lNenhum := __fuse_out_0_0

  // over a work area, and no map is needed: a predicate reads the record
  __fuse_area_0_0 := Alias()
  DbSelectArea("SA1")
  __fuse_rec_0_0 := SA1->(RecNo())
  SA1->(DbGoTop())
  __fuse_out_0_0 := .F.

  While !SA1->(Eof())
    If SA1->A1_SALDO < 0
      __fuse_out_0_0 := .T.
      Exit
    EndIf
    SA1->(DbSkip())
  EndDo

  SA1->(DbGoto(__fuse_rec_0_0))

  If !Empty(__fuse_area_0_0)
    DbSelectArea(__fuse_area_0_0)
  EndIf

  lNegativo := __fuse_out_0_0

  // sort cannot be fused, so the predicate runs as an ordinary call
  __pipe_tmp_0_0 := u_xtpl_sort(aNums)
  __pipe_tmp_0_1 := u_xtpl_noneof(__pipe_tmp_0_0, {|%n^0%| %n^0% == 0})
  lOrdenado := __pipe_tmp_0_1

  return lAlguem .and. lTodos .and. lNenhum .and. lNegativo .and. lOrdenado

// --------------------------------------------------------------------------------
// the end