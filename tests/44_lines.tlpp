#include "totvs.ch"
#include "tlpp-core.th"

// 44_lines.tlpp -- a chain over the lines of a file.
//
// The same source protocol as rows(), over text: FT_FUse opens, FT_FReadLn
// reads one line, FT_FSkip advances, FT_FUse() with no argument closes. The
// file is never held in memory, so a 'take' really does stop the read rather
// than trimming something already loaded.
//
// Unlike rows(), the element here IS a value -- the line -- so a lambda
// parameter binds to it in the ordinary way.
// --------------------------------------------------------------------------------

user function testLines(cPath)

  Local aTop := {}
  Local aAll := {}
  Local nBytes := 0
  Local aSorted := {}

  Local __fuse_n_0_0
  Local __fuse_out_0_0
  Local __fuse_src_0_0
  Local __fuse_v_0_0
  Local __pipe_tmp_0_0

  // filter, map and take: one pass, and it stops after ten lines
  __fuse_out_0_0 := {}
  __fuse_src_0_0 := "dados.txt"

  If File(__fuse_src_0_0)
    FT_FUse(__fuse_src_0_0)
    FT_FGoTop()
  __fuse_n_0_0 := 0
    While !FT_FEof()
      __fuse_v_0_0 := FT_FReadLn()
      If !empty(__fuse_v_0_0)
        __fuse_v_0_0 := alltrim(__fuse_v_0_0)
        If __fuse_n_0_0 >= 10
          Exit
        EndIf
        __fuse_n_0_0 := __fuse_n_0_0 + 1
        AAdd(__fuse_out_0_0, __fuse_v_0_0)
      EndIf
      FT_FSkip()
    EndDo
    FT_FUse()
  EndIf

  aTop := __fuse_out_0_0

  // no stages at all is still a chain: every line of the file
  __fuse_out_0_0 := {}
  __fuse_src_0_0 := cPath

  If File(__fuse_src_0_0)
    FT_FUse(__fuse_src_0_0)
    FT_FGoTop()
    While !FT_FEof()
      __fuse_v_0_0 := FT_FReadLn()
      AAdd(__fuse_out_0_0, __fuse_v_0_0)
      FT_FSkip()
    EndDo
    FT_FUse()
  EndIf

  aAll := __fuse_out_0_0

  // a fold as the last stage builds no array
  __fuse_out_0_0 := 0
  __fuse_src_0_0 := cPath

  If File(__fuse_src_0_0)
    FT_FUse(__fuse_src_0_0)
    FT_FGoTop()
    While !FT_FEof()
      __fuse_v_0_0 := FT_FReadLn()
      __fuse_v_0_0 := len(__fuse_v_0_0)
      __fuse_out_0_0 := __fuse_out_0_0 + __fuse_v_0_0
      FT_FSkip()
    EndDo
    FT_FUse()
  EndIf

  nBytes := __fuse_out_0_0

  // sort cannot be fused, so the walk collects and sort carries on from there
  __fuse_out_0_0 := {}
  __fuse_src_0_0 := cPath

  If File(__fuse_src_0_0)
    FT_FUse(__fuse_src_0_0)
    FT_FGoTop()
    While !FT_FEof()
      __fuse_v_0_0 := FT_FReadLn()
      AAdd(__fuse_out_0_0, __fuse_v_0_0)
      FT_FSkip()
    EndDo
    FT_FUse()
  EndIf

  __pipe_tmp_0_0 := u_xtpl_sort(__fuse_out_0_0)
  aSorted := __pipe_tmp_0_0

  return nBytes + len(aTop) + len(aAll) + len(aSorted)

// --------------------------------------------------------------------------------
// the end