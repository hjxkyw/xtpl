#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Uma variavel de bloco num slot se escreve '!nome^...!'. Com dois
// numeros o armazenamento e dividido e nao tem nome honesto --
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Com um so, o slot
// leva o nome de quem o ocupa, que e o unico.
//
// '%nome^n%' e a que nao ganhou slot: fixada por uma captura, um '@',
// uma linha 'raw' ou um 'defer', ou o parametro de um lambda.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => __stk_<num1>_<num2>
#translate !<name>^<num>! => __stk_<num>_<name>
#translate %<name>^<num>% => __blk_<num>_<name>

// 44_lines.tlpp -- a chain over the lines of a file.
//
// The same source protocol as rows(), over text: FT_FUse opens, FT_FReadLn
// reads one line, FT_FSkip advances, FT_FUse() with no argument closes. The
// file is never held in memory, so a 'take' really does stop the read rather
// than trimming something already loaded.
//
// Unlike rows(), the element here IS a value -- the line -- so a lambda
// parameter binds to it in the ordinary way.
// --------------------------------------------------------------------------------

user function testLines(cPath)

  Local aTop := {}
  Local aAll := {}
  Local nBytes := 0
  Local aSorted := {}

  Local __blk_0_l
  Local __fuse_n_0_0
  Local __fuse_out_0_0
  Local __fuse_src_0_0
  Local __fuse_v_0_0
  Local __pipe_tmp_0_0


  // filter, map and take: one pass, and it stops after ten lines
  __fuse_src_0_0 := "dados.txt"
  FT_FUse(__fuse_src_0_0)
  FT_FGoTop()
  __fuse_n_0_0 := 0
  __fuse_out_0_0 := {}
  While File(__fuse_src_0_0) .And. !FT_FEof()
    __fuse_v_0_0 := FT_FReadLn()
    %l^0% := __fuse_v_0_0
    If !empty(%l^0%)
      %l^0% := __fuse_v_0_0
      __fuse_v_0_0 := alltrim(%l^0%)
      If __fuse_n_0_0 >= 10
        Exit
      EndIf
      __fuse_n_0_0 := __fuse_n_0_0 + 1
      AAdd(__fuse_out_0_0, __fuse_v_0_0)
    EndIf
    FT_FSkip()
  EndDo
  FT_FUse()
  aTop := __fuse_out_0_0

  // no stages at all is still a chain: every line of the file
  __fuse_src_0_0 := cPath
  FT_FUse(__fuse_src_0_0)
  FT_FGoTop()
  __fuse_out_0_0 := {}
  While File(__fuse_src_0_0) .And. !FT_FEof()
    __fuse_v_0_0 := FT_FReadLn()
    AAdd(__fuse_out_0_0, __fuse_v_0_0)
    FT_FSkip()
  EndDo
  FT_FUse()
  aAll := __fuse_out_0_0

  // a fold as the last stage builds no array
  __fuse_src_0_0 := cPath
  FT_FUse(__fuse_src_0_0)
  FT_FGoTop()
  __fuse_out_0_0 := 0
  While File(__fuse_src_0_0) .And. !FT_FEof()
    __fuse_v_0_0 := FT_FReadLn()
    %l^0% := __fuse_v_0_0
    __fuse_v_0_0 := len(%l^0%)
    __fuse_out_0_0 := __fuse_out_0_0 + __fuse_v_0_0
    FT_FSkip()
  EndDo
  FT_FUse()
  nBytes := __fuse_out_0_0

  // sort cannot be fused, so the walk collects and sort carries on from there
  __fuse_src_0_0 := cPath
  FT_FUse(__fuse_src_0_0)
  FT_FGoTop()
  __fuse_out_0_0 := {}
  While File(__fuse_src_0_0) .And. !FT_FEof()
    __fuse_v_0_0 := FT_FReadLn()
    AAdd(__fuse_out_0_0, __fuse_v_0_0)
    FT_FSkip()
  EndDo
  FT_FUse()
  __pipe_tmp_0_0 := u_xtpl_sort(__fuse_out_0_0)
  aSorted := __pipe_tmp_0_0

  return nBytes + len(aTop) + len(aAll) + len(aSorted)

// --------------------------------------------------------------------------------
// the end