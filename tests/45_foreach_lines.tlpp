#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 45_foreach_lines.tlpp -- 'for' over the lines of a file.
//
// This works where 'for' over rows() would not: the element here IS a
// value -- the line -- so it binds to a name in the ordinary way and the body
// needs no rewriting. A work-area record is not a value, which is why the
// same shape was refused there.
//
// FT_FSkip() sits straight after the read rather than at the foot of the
// loop. The body is the programmer's, so it may contain a 'Loop', and a Loop
// over a skip at the foot would never advance the file.
//
// Closing the file is an exit-path job, like restoring a work area: an early
// return has to close it too.
// --------------------------------------------------------------------------------

user function testForeachLines(cPath)

  Local nTotal := 0

  Local s_1_cLinha
  Local s_1_each
  Local s_1_nNumero
  Local s_1_opened

  let each as s_1_each
  let cLinha as s_1_cLinha
  let nNumero as s_1_nNumero
  s_1_each := cPath
  let opened as s_1_opened
  s_1_opened := File(s_1_each)

  If s_1_opened
    FT_FUse(s_1_each)
    FT_FGoTop()
  EndIf

  s_1_nNumero := 0

  While s_1_opened .And. !FT_FEof()
    s_1_nNumero := s_1_nNumero + 1
    s_1_cLinha := FT_FReadLn()
    FT_FSkip()
    if empty(s_1_cLinha)
      loop  // safe: the file has already advanced
    endif

    nTotal := nTotal + len(s_1_cLinha)

    If nTotal > 1000  // closes the file on the way out
      If s_1_opened
        FT_FUse()
      EndIf
      Return s_1_nNumero
    EndIf

  EndDo

  If s_1_opened
    FT_FUse()
  EndIf

  return nTotal

// --------------------------------------------------------------------------------
// the end