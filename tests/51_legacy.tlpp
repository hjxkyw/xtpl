#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 51_legacy.tlpp -- --legacy: reading code xtpl would otherwise refuse.
//
// One thing stops xtpl accepting an existing .prw: a write to an undeclared
// name. AdvPL allows it and creates a PRIVATE -- an anti-pattern, but legal --
// while xtpl refuses it. --legacy makes it a warning.
//
// Reading an undeclared name is an error in AdvPL too, so that check is not an
// xtpl restriction. Nor is the prologue: AdvPL rejects a Local after the first
// statement and a Local inside a block, so no file that compiles today has
// either. Relaxing the prologue is a convenience.
//
// A name a write brought into being is reported once, where it happens -- the
// reads after it are of a variable that by then exists.
//
// --legacy does not touch scoping. Block-scoped local is something xtpl adds
// where AdvPL has nothing, so there is no existing meaning to preserve.
// --------------------------------------------------------------------------------

#xtranslate MOSTRE <x> => conout(<x>)

User Function Legado(cCodigo)

  Local nTotal := 0
  Local cNome

  Local s_1_nExtra

   nTotal := 10
   cNome := "x"  // fora do prólogo: aviso, e o valor fica aqui

   If nTotal > 5
      let nExtra as s_1_nExtra
      s_1_nExtra := 1  // bloco: xtpl acrescenta isto, o AdvPL recusa
      nTotal := nTotal + s_1_nExtra
   Endif

   cNaoDeclarado := nTotal  // cria uma PRIVATE: avisado uma vez, aqui
   nTotal := nTotal + len(cNaoDeclarado)  // leitura: existe agora, sem aviso

   MOSTRE cValToChar(nTotal)

   conout(cNome + cNaoDeclarado)

Return nTotal

// --------------------------------------------------------------------------------
// the end