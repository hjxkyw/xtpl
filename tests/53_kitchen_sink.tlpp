#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Onde um slot e dividido por mais de uma variavel ele nao tem nome
// honesto, entao cada linha o escreve com o nome de quem o ocupa ali:
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Os outros nomes ja
// dizem de quem sao -- 's_1_aTmp', 'b_0_nFator'.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => s_<num1>_<num2>

// 53_kitchen_sink.tlpp
// --------------------------------------------------------------------------------

user function testKitchenSink()

  // 1. Function-level initialization (Unmangled, native declarations)
  Local nTotal := 100
  Local aHandlers := {}
  Local nCount := 0
  Local i
  Local aList
  Local aLoopList
  Local cCache
  Local cName
  Local cPick

  Local s_1_0        // idx, nDiscount, lSuccess, cNode, subList, conditionalList, k, nSlotA, cSlotB, nCount, nOuter, j, lReady, nScratch, aRows, aLocalOnly, aInner, nRowCount, nPlain
  Local s_1_1        // nSquare, aBatch, aCarrier
  Local b_1_nFactor
  Local b_2_cBuffer
  Local et_0_0
  Local s_2_nInner

  // 2. Traditional for loop (Passes safety check because 'i' is declared above)
  for i := 1 to 3
    nCount := nCount + i
  next

  // 3. Block-scoped for loop (loop counter takes a depth-1 stack slot)
  let idx as s_1_0

  for !idx^1^0! := 1 to 5
    conout("Index: " + cValToChar(!idx^1^0!))
  next

  // 4. Block-scoped shadowing (First block)
  if nTotal > 50
    let nDiscount as s_1_0
    !nDiscount^1^0! := 10
    nTotal := nTotal - !nDiscount^1^0!
    conout("Discount A: " + cValToChar(!nDiscount^1^0!))
  endif

  // 5. Block-scoped shadowing (Second block - isolated from the first)
  if nTotal > 20
    let nDiscount as s_1_0
    !nDiscount^1^0! := 5
    nTotal := nTotal - !nDiscount^1^0!
    conout("Discount B: " + cValToChar(!nDiscount^1^0!))
  endif

  // 6. 'if local' conditional binding with explicit condition after comma
  let lSuccess as s_1_0
  !lSuccess^1^0! := myAction("param1, with comma")

  If !lSuccess^1^0! == .T.
    conout("Action succeeded!")
  endif

  // 7. 'while local' loop binding with explicit condition after comma
  let cNode as s_1_0

  While (!cNode^1^0! := getNextNode()) != Nil
    conout("Processing: " + !cNode^1^0!)
  enddo

  // 8. Block-scoped array built in place
  if nTotal > 10
    let subList as s_1_0
    !subList^1^0! := {}
    aadd(!subList^1^0!, "X")
    aadd(!subList^1^0!, "Y")
  endif

  // 9. Function-level array (depth 0, so private storage)
  aList := {}
  aadd(aList, "A")
  aadd(aList, "B")

  if nTotal > 80
    aadd(aList, "C")
  endif

  // 10. Conditional appends inside an 'if' block
  if nTotal > 50
    let conditionalList as s_1_0
    !conditionalList^1^0! := {}
    aadd(!conditionalList^1^0!, "DefaultItem")
    if nTotal > 75
      aadd(!conditionalList^1^0!, "HighValueItem")
    endif
  endif

  // 11. Appends from inside a 'for' loop, some behind an inner 'if'
  aLoopList := {}
  let k as s_1_0

  for !k^1^0! := 1 to 4
    aadd(aLoopList, "Item_" + cValToChar(!k^1^0!))
    if !k^1^0! % 2 == 0
      aadd(aLoopList, "EvenBonus_" + cValToChar(!k^1^0!))
    endif
  next

  // 12. Block locals: two sibling blocks share one slot
  if nTotal > 0
    let nSlotA as s_1_0
    !nSlotA^1^0! := 1
    conout("Slot A: " + cValToChar(!nSlotA^1^0!))
  endif

  if nTotal > 0
    let cSlotB as s_1_0
    !cSlotB^1^0! := "reuses the same storage"
    conout("Slot B: " + !cSlotB^1^0!)
  endif

  // 13. Shadowing: 'local' hides the function-level nCount inside the block only
  if nTotal > 0
    let nCount as s_1_0
    !nCount^1^0! := 999
    conout("Shadowed: " + cValToChar(!nCount^1^0!))
  endif

  conout("Restored: " + cValToChar(nCount))

  // 14. Nesting: the inner block sits one level deeper, so it gets its own slot
  if nTotal > 0
    let nOuter as s_1_0
    !nOuter^1^0! := 1
    if nTotal > 1
      let nInner as s_2_nInner
      s_2_nInner := 2
      conout("Sum: " + cValToChar(!nOuter^1^0! + s_2_nInner))
    endif
  endif

  // 15. 'for local' counter, plus a body slot recycled on every iteration
  let j as s_1_0

  for !j^1^0! := 1 to 3
    let nSquare as s_1_1
    !nSquare^1^1! := !j^1^0! * !j^1^0!
    conout("Square: " + cValToChar(!nSquare^1^1!))
  next

  // 16. 'if local' binding, with an array built inside the block
  let lReady as s_1_0
  !lReady^1^0! := checkReady()

  If !lReady^1^0!
    let aBatch as s_1_1
    !aBatch^1^1! := {}
    aadd(!aBatch^1^1!, "batch1")
    aadd(!aBatch^1^1!, "batch2")
    conout("Batch: " + cValToChar(len(!aBatch^1^1!)))
  endif

  // 17. Bare 'local' is cleared on entry so no sibling value leaks in
  if nTotal > 0
    let nScratch as s_1_0
    !nScratch^1^0! := Nil
    !nScratch^1^0! := nTotal * 2
    conout("Scratch: " + cValToChar(!nScratch^1^0!))
  endif

  // 18. Captured by a code block: nFactor outlives the block, so it keeps
  //     private storage instead of a recycled slot
  if nTotal > 0
    let nFactor as b_1_nFactor
    b_1_nFactor := 10
    aadd(aHandlers, {|| b_1_nFactor * 2})
  endif

  // 19. Value variable passed with @: the callee writes back during the call
  //     and cannot keep the binding, so it still shares a slot
  if nTotal > 0
    let cBuffer as b_2_cBuffer
    b_2_cBuffer := ""
    fillBuffer(@b_2_cBuffer)
    conout("Buffer: " + b_2_cBuffer)
  endif

  // 20. Escapes: aRows is an array handed to a user function, which may keep it
  if nTotal > 0
    let aRows as s_1_0
    !aRows^1^0! := {}
    processRows(!aRows^1^0!)
  endif

  // 21. Contained: built up and read in place, so it still shares a slot
  if nTotal > 0
    let aLocalOnly as s_1_0
    !aLocalOnly^1^0! := {}
    aadd(!aLocalOnly^1^0!, "kept in the block")
    conout("Rows: " + cValToChar(len(!aLocalOnly^1^0!)))
  endif

  // 22. Escapes transitively: aInner never reaches processRows directly, but
  //     storing it into aCarrier is itself the escape -- no need to prove
  //     where aCarrier goes afterwards
  if nTotal > 0
    let aInner as s_1_0
    let aCarrier as s_1_1
    !aInner^1^0! := {}
    !aCarrier^1^1! := {}
    aadd(!aCarrier^1^1!, !aInner^1^0!)
    processRows(!aCarrier^1^1!)
  endif

  // 23. Scalar passed to a user function: copied, so sharing is safe
  if nTotal > 0
    let nRowCount as s_1_0
    !nRowCount^1^0! := 5
    processRows(!nRowCount^1^0!)
  endif

  // 24. Value variable, never captured, so it shares a slot
  if nTotal > 0
    let nPlain as s_1_0
    !nPlain^1^0! := 42
    conout("Plain: " + cValToChar(!nPlain^1^0!))
  endif

  // 25. '?=' as an operator: fill in a value only if nothing landed there.
  //     Not a declaration form -- a fresh local is always Nil.
  if nTotal > 90
    cCache := loadFromCache()
  endif

  If cCache == Nil
    cCache := "empty"
  EndIf

  conout("Cache: " + cCache)

  // 26. Elvis: same idea inline, with the left side evaluated exactly once
  et_0_0 := lookupName(nTotal)
  cName := If(et_0_0 != Nil, et_0_0, "anonymous")

  // 27. Chained elvis: each fallback runs only if the one before came back Nil
  et_0_0 := firstChoice()

  If et_0_0 == Nil
    et_0_0 := secondChoice()
    If et_0_0 == Nil
      et_0_0 := "last resort"
    EndIf
  EndIf

  cPick := et_0_0

  return nTotal

// --------------------------------------------------------------------------------
// the end