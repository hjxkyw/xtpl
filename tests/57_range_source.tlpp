#include "totvs.ch"
#include "tlpp-core.th"

// Armazenamento dividido por mais de uma variavel de bloco.
//
// 'let' marca onde uma variavel de bloco e declarada e qual
// armazenamento ela recebeu. Nao gera nada.
//
// Uma variavel de bloco num slot se escreve '!nome^...!'. Com dois
// numeros o armazenamento e dividido e nao tem nome honesto --
// '!aTmp^1^0!' e '!cOutro^1^0!' sao o mesmo slot. Com um so, o slot
// leva o nome de quem o ocupa, que e o unico.
//
// '%nome^n%' e a que nao ganhou slot: fixada por uma captura, um '@',
// uma linha 'raw' ou um 'defer', ou o parametro de um lambda.
//
// Uma regra so, para todos os slots: os marcadores entram no proprio
// nome do resultado. O '!' na frente impede que a regra case com uma
// potenciacao de verdade, 'a^2^3'; o '!' no fim fecha o padrao, sem
// o qual o ultimo marcador engole o que vem depois.
#translate let <name1> as <name2> =>
#translate !<name>^<num1>^<num2>! => __stk_<num1>_<num2>
#translate !<name>^<num>! => __stk_<num>_<name>
#translate %<name>^<num>% => __blk_<num>_<name>

// 57_range_source.tlpp -- 'lo..hi' como fonte de uma cadeia.
//
// A mesma grafia que 'in 1..100' usa, e a unica fonte que percorre sem uma
// colecao atras: o laco conta, e nada e alocado.
//
//    n := 1..999 |> filter([x] x %% 3 .or. x %% 5) |> asum
//
// que e o primeiro problema do Project Euler, e em Raku se escreve
//
//    say sum((1..999).grep: * %% (3 | 5))
//
// O contador e o elemento sao variaveis DIFERENTES. Fazer o contador ser o
// elemento economizava uma atribuicao e quebrava o laco: um 'map' escreve no
// elemento, e escrever no contador de um For muda o que ele percorre.
// --------------------------------------------------------------------------------

user function testRangeSource(nLo, nHi)

  Local nEuler := 0
  Local aDobros := {}
  Local nQuantos := 0
  Local nCalculado := 0
  Local aPrimeiros := {}

  Local __blk_0_x
  Local __fuse_hi_0_0
  Local __fuse_i_0_0
  Local __fuse_lo_0_0
  Local __fuse_n_0_0
  Local __fuse_out_0_0
  Local __fuse_v_0_0
  Local __pipe_tmp_0_0

  // literal dos dois lados: entra direto no cabecalho
  __fuse_out_0_0 := 0

  For __fuse_i_0_0 := 1 To 999
    __fuse_v_0_0 := __fuse_i_0_0
    If (__fuse_v_0_0 % 3) == 0 .or. (__fuse_v_0_0 % 5) == 0
      __fuse_out_0_0 := __fuse_out_0_0 + __fuse_v_0_0
    EndIf
  Next

  nEuler := __fuse_out_0_0

  // um map escreve no elemento, entao o contador tem de ser outro
  __pipe_tmp_0_0 := u_xtpl_map(1..10, {|%x^0%| %x^0% * 2})
  aDobros := __pipe_tmp_0_0

  // contagem com teste, sem construir nada
  __pipe_tmp_0_0 := u_xtpl_count(1..100, {|%x^0%| (%x^0% % 7) == 0})
  nQuantos := __pipe_tmp_0_0

  // pontas calculadas: ligadas antes do laco
  __fuse_lo_0_0 := nLo
  __fuse_hi_0_0 := calcFim(nHi)
  __fuse_out_0_0 := 0

  For __fuse_i_0_0 := __fuse_lo_0_0 To __fuse_hi_0_0
    __fuse_v_0_0 := __fuse_i_0_0
    If __fuse_v_0_0 > 0
      __fuse_out_0_0 := __fuse_out_0_0 + __fuse_v_0_0
    EndIf
  Next

  nCalculado := __fuse_out_0_0

  // take corta o percurso, nao o resultado
  __fuse_n_0_0 := 0
  __fuse_out_0_0 := {}

  For __fuse_i_0_0 := 1 To 1000000
    __fuse_v_0_0 := __fuse_i_0_0
    If (__fuse_v_0_0 % 3) == 0
      If __fuse_n_0_0 >= 4
        Exit
      EndIf
      __fuse_n_0_0 := __fuse_n_0_0 + 1
      AAdd(__fuse_out_0_0, __fuse_v_0_0)
    EndIf
  Next

  aPrimeiros := __fuse_out_0_0

  return nEuler + len(aDobros) + nQuantos + nCalculado + len(aPrimeiros)

// --------------------------------------------------------------------------------
// the end